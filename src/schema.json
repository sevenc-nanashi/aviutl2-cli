{
  "type": "object",
  "title": "schema",
  "properties": {
    "project": {
      "type": "object",
      "title": "Project",
      "description": "プロジェクト設定",
      "properties": {
        "id": {
          "type": "string",
          "description": "プロジェクトID"
        },
        "name": {
          "type": "string",
          "description": "プロジェクト名"
        },
        "version": {
          "type": "string",
          "description": "バージョン"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ]
    },
    "artifacts": {
      "type": "object",
      "description": "成果物の定義",
      "additionalProperties": {
        "type": "object",
        "title": "Artifact",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "成果物の有効/無効（デフォルトは true）",
            "nullable": true
          },
          "source": {
            "type": "string",
            "description": "成果物のパス",
            "nullable": true
          },
          "destination": {
            "type": "string",
            "description": "AviUtl2 の data 配下での配置先"
          },
          "build": {
            "title": "BuildCommand",
            "description": "ビルドコマンド",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "title": "BuildGroupRef",
                "properties": {
                  "group": {
                    "type": "string",
                    "description": "利用する build_group のキー"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "group"
                ]
              }
            ],
            "nullable": true
          },
          "placement_method": {
            "type": "string",
            "title": "PlacementMethod",
            "description": "配置方法（symlink / copy）",
            "enum": [
              "symlink",
              "copy"
            ],
            "nullable": true
          },
          "profiles": {
            "type": "object",
            "description": "プロファイルごとの設定",
            "additionalProperties": {
              "type": "object",
              "title": "ArtifactProfile",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "成果物の有効/無効（デフォルトは true）",
                  "nullable": true
                },
                "source": {
                  "type": "string",
                  "description": "成果物のパス",
                  "nullable": true
                },
                "build": {
                  "title": "BuildCommand",
                  "description": "ビルドコマンド",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "object",
                      "title": "BuildGroupRef",
                      "properties": {
                        "group": {
                          "type": "string",
                          "description": "利用する build_group のキー"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "group"
                      ]
                    }
                  ],
                  "nullable": true
                }
              },
              "additionalProperties": false
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "required": [
          "destination"
        ]
      },
      "nullable": true
    },
    "build_group": {
      "type": "object",
      "description": "ビルドコマンドのグループ定義",
      "additionalProperties": {
        "title": "BuildCommand",
        "description": "単一または複数のビルドコマンド",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "title": "BuildGroupRef",
            "properties": {
              "group": {
                "type": "string",
                "description": "利用する build_group のキー"
              }
            },
            "additionalProperties": false,
            "required": [
              "group"
            ]
          }
        ]
      },
      "nullable": true
    },
    "development": {
      "type": "object",
      "title": "Development",
      "description": "開発用の設定",
      "properties": {
        "aviutl2_version": {
          "type": "string",
          "description": "AviUtl2 のバージョン"
        },
        "install_dir": {
          "type": "string",
          "description": "AviUtl2 のインストール先",
          "nullable": true
        },
        "profile": {
          "type": "string",
          "description": "使うプロファイル名（デフォルトは debug）",
          "nullable": true
        },
        "prebuild": {
          "title": "BuildCommand",
          "description": "事前ビルドコマンド",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "title": "BuildGroupRef",
              "properties": {
                "group": {
                  "type": "string",
                  "description": "利用する build_group のキー"
                }
              },
              "additionalProperties": false,
              "required": [
                "group"
              ]
            }
          ],
          "nullable": true
        },
        "postbuild": {
          "title": "BuildCommand",
          "description": "事後ビルドコマンド",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "title": "BuildGroupRef",
              "properties": {
                "group": {
                  "type": "string",
                  "description": "利用する build_group のキー"
                }
              },
              "additionalProperties": false,
              "required": [
                "group"
              ]
            }
          ],
          "nullable": true
        },
        "catalog_dependencies": {
          "type": "array",
          "description": "カタログからインストールするパッケージのリスト",
          "items": {
            "title": "CatalogDependency",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "title": "VerboseCatalogDependency",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "カタログからインストールするパッケージのID"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "id"
                ]
              }
            ]
          },
          "nullable": true
        }
      },
      "additionalProperties": false,
      "required": [
        "aviutl2_version"
      ],
      "nullable": true
    },
    "preview": {
      "type": "object",
      "title": "Preview",
      "description": "プレビュー用の設定",
      "properties": {
        "aviutl2_version": {
          "type": "string",
          "description": "AviUtl2 のバージョン（省略時は development.aviutl2_version）",
          "nullable": true
        },
        "install_dir": {
          "type": "string",
          "description": "AviUtl2 のインストール先",
          "nullable": true
        },
        "profile": {
          "type": "string",
          "description": "使うプロファイル名（デフォルトは release）",
          "nullable": true
        },
        "include": {
          "type": "array",
          "description": "含める成果物のリスト（省略時は release.include を使用）",
          "items": {
            "type": "string"
          },
          "nullable": true
        },
        "prebuild": {
          "title": "BuildCommand",
          "description": "事前ビルドコマンド",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "title": "BuildGroupRef",
              "properties": {
                "group": {
                  "type": "string",
                  "description": "利用する build_group のキー"
                }
              },
              "additionalProperties": false,
              "required": [
                "group"
              ]
            }
          ],
          "nullable": true
        },
        "postbuild": {
          "title": "BuildCommand",
          "description": "事後ビルドコマンド",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "title": "BuildGroupRef",
              "properties": {
                "group": {
                  "type": "string",
                  "description": "利用する build_group のキー"
                }
              },
              "additionalProperties": false,
              "required": [
                "group"
              ]
            }
          ],
          "nullable": true
        },
        "catalog_dependencies": {
          "type": "array",
          "description": "カタログからインストールするパッケージのリスト",
          "items": {
            "title": "CatalogDependency",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "title": "VerboseCatalogDependency",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "カタログからインストールするパッケージのID"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "id"
                ]
              }
            ]
          },
          "nullable": true
        }
      },
      "additionalProperties": false,
      "nullable": true
    },
    "release": {
      "type": "object",
      "title": "Release",
      "description": "リリース用の設定",
      "properties": {
        "output_dir": {
          "type": "string",
          "description": "出力ディレクトリ",
          "nullable": true
        },
        "package_template": {
          "type": "string",
          "description": "package.txt のテンプレート",
          "nullable": true
        },
        "package_id": {
          "type": "string",
          "description": "au2pkgでのID（package.ini の `id` に相当、デフォルトは `{id}`）",
          "nullable": true
        },
        "package_name": {
          "type": "string",
          "description": "au2pkgでのパッケージ名（package.ini の `name` に相当、デフォルトは `{name}`）",
          "nullable": true
        },
        "package_information": {
          "type": "string",
          "description": "au2pkgでの情報欄（package.ini の `information` に相当、デフォルトは `{name} v{version}`）",
          "nullable": true
        },
        "uninstall_subfolder_file": {
          "type": "boolean",
          "description": "アンインストール時に、作成したフォルダ内の別ファイルを削除するかどうか（package.ini の `uninstallSubFolderFile` に相当、デフォルトは false）",
          "nullable": true
        },
        "zip_name": {
          "type": "string",
          "description": "zip の名前（`.au2pkg.zip` は自動付与、デフォルトは `{id}-v{version}.au2pkg.zip`）",
          "nullable": true
        },
        "profile": {
          "type": "string",
          "description": "使うプロファイル名（デフォルトは release）",
          "nullable": true
        },
        "include": {
          "type": "array",
          "description": "含める成果物のリスト（省略時はすべて含める）",
          "items": {
            "type": "string"
          },
          "nullable": true
        },
        "prebuild": {
          "title": "BuildCommand",
          "description": "事前ビルドコマンド",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "title": "BuildGroupRef",
              "properties": {
                "group": {
                  "type": "string",
                  "description": "利用する build_group のキー"
                }
              },
              "additionalProperties": false,
              "required": [
                "group"
              ]
            }
          ],
          "nullable": true
        },
        "postbuild": {
          "title": "BuildCommand",
          "description": "事後ビルドコマンド",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "title": "BuildGroupRef",
              "properties": {
                "group": {
                  "type": "string",
                  "description": "利用する build_group のキー"
                }
              },
              "additionalProperties": false,
              "required": [
                "group"
              ]
            }
          ],
          "nullable": true
        }
      },
      "additionalProperties": false,
      "nullable": true
    },
    "catalog": {
      "type": "object",
      "title": "Catalog",
      "description": "AviUtl2 カタログの定義",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID"
        },
        "description_path": {
          "type": "string",
          "description": "説明文へのパス",
          "nullable": true
        },
        "license_path": {
          "description": "ライセンスへのパス",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "title": "CatalogLicensePath",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "LicenseType",
                  "description": "ライセンス種別",
                  "enum": [
                    "MIT",
                    "Apache-2.0",
                    "BSD-2-Clause",
                    "BSD-3-Clause",
                    "CC0-1.0",
                    "GPL-2.0",
                    "GPL-3.0",
                    "Unlicense",
                    "custom"
                  ]
                },
                "path": {
                  "type": "string",
                  "description": "ライセンス本文へのパス"
                }
              },
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ]
            }
          ],
          "nullable": true
        },
        "download_repo": {
          "type": "object",
          "title": "CatalogDownloadRepo",
          "description": "ダウンロード元のGitHubリポジトリ",
          "properties": {
            "owner": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "owner",
            "repo"
          ],
          "nullable": true
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "nullable": true
    }
  },
  "additionalProperties": false,
  "required": [
    "project"
  ]
}
